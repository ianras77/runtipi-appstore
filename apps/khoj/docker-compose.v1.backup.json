{
  "services": [
    {
      "name": "khoj",
      "image": "khojdev/khoj:latest",
      "isMain": true,
      "internalPort": 42110,
      "restart": "unless-stopped",
      "environment": {
        "KHOJ_ADMIN_EMAIL": "${KHOJ_ADMIN_EMAIL}",
        "KHOJ_ADMIN_PASSWORD": "${KHOJ_ADMIN_PASSWORD}",
        "KHOJ_DJANGO_SECRET_KEY": "${KHOJ_DJANGO_SECRET_KEY}",
        "KHOJ_DOMAIN": "${KHOJ_DOMAIN}",
        "KHOJ_NO_HTTPS": "true",
        "DATABASE_URL": "postgres://khoj:${POSTGRES_PASSWORD}@db:5432/khoj"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/root/.khoj"
        }
      ],
      "dependsOn": {
        "db": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "db",
      "image": "postgres:15-alpine",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "khoj",
        "POSTGRES_USER": "khoj",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ]
    }
  ]
}