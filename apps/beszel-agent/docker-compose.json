{
  "services": [
    {
      "name": "beszel-agent",
      "image": "henrygd/beszel-agent:0.18.7",
      "isMain": true,
      "internalPort": 45876,
      "networkMode": "host",
      "environment": [
        {
          "key": "PORT",
          "value": 45876
        },
        {
          "key": "KEY",
          "value": "${BESZEL_AGENT_KEY}"
        }
      ],
      "volumes": [
        {
          "hostPath": "/var/run/docker.sock",
          "containerPath": "/var/run/docker.sock",
          "readOnly": true
        }
      ]
    }
  ],
  "$schema": "../dynamic-compose-schema.json",
  "schema": "2",
  "schemaVersion": 2
}
