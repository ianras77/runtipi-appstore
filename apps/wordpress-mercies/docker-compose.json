{
  "$schema": "../dynamic-compose-schema.json",
  "schema": "2",
  "services": [
    {
      "name": "wordpress-mercies",
      "image": "wordpress:latest",
      "environment": [
        {
          "key": "WORDPRESS_DB_HOST",
          "value": "wordpress-mercies-db"
        },
        {
          "key": "WORDPRESS_DB_NAME",
          "value": "wordpress"
        },
        {
          "key": "WORDPRESS_DB_USER",
          "value": "tipi"
        },
        {
          "key": "WORDPRESS_DB_PASSWORD",
          "value": "${DB_PASSWORD}"
        },
        {
          "key": "VIRTUAL_HOST",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "SERVER_NAME",
          "value": "${APP_DOMAIN}"
        }
      ],
      "internalPort": 80,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/wordpress",
          "containerPath": "/var/www/html",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "dependsOn": {
        "wordpress-mercies-db": {
          "condition": "service_started"
        }
      },
      "isMain": true
    },
    {
      "name": "wordpress-mercies-db",
      "image": "mariadb:11.1.3",
      "environment": [
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "value": "${DB_ROOT_PASSWORD}"
        },
        {
          "key": "MYSQL_DATABASE",
          "value": "wordpress"
        },
        {
          "key": "MYSQL_USER",
          "value": "tipi"
        },
        {
          "key": "MYSQL_PASSWORD",
          "value": "${DB_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/mariadb",
          "containerPath": "/var/lib/mysql",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ],
  "schemaVersion": 2
}