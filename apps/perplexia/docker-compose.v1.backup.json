{
  "services": [
    {
      "name": "frontend",
      "image": "itzcrazykns/perplexica-frontend:1.9.0",
      "isMain": true,
      "internalPort": 3000,
      "environment": {
        "NEXT_PUBLIC_API_URL": "http://${APP_DOMAIN}/api"
      },
      "dependsOn": {
        "backend": {
          "condition": "service_started"
        }
      },
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost:3000 || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "backend",
      "image": "itzcrazykns/perplexica-backend:1.9.0",
      "internalPort": 3001,
      "environment": {
        "DATABASE_URL": "postgresql://perplexica:${PERPLEXICA_DB_PASSWORD}@postgres:5432/perplexica",
        "NODE_ENV": "production"
      },
      "dependsOn": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost:3001/health || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16",
      "environment": {
        "POSTGRES_DB": "perplexica",
        "POSTGRES_USER": "perplexica",
        "POSTGRES_PASSWORD": "${PERPLEXICA_DB_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "pg_isready -U perplexica -d perplexica",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    }
  ]
}