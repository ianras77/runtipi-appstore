{
  "services": [
    {
      "name": "frontend",
      "image": "itzcrazykns1337/perplexica-frontend:v1.9.3",
      "isMain": true,
      "internalPort": 3000,
      "environment": {
        "NEXT_PUBLIC_API_URL": "http://backend:3001/api",
        "NEXT_PUBLIC_WS_URL": "ws://backend:3001"
      },
      "dependsOn": { "backend": { "condition": "service_started" } },
      "restart": "unless-stopped"
    },
    {
      "name": "backend",
      "image": "itzcrazykns1337/perplexica-backend:main",
      "environment": {
        "SEARXNG_API_URL": "http://searxng:8080"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/perplexica/data", "containerPath": "/home/perplexica/data" },
        { "hostPath": "${APP_DATA_DIR}/perplexica/uploads", "containerPath": "/home/perplexica/uploads" }
      ],
      "dependsOn": { "searxng": { "condition": "service_started" } },
      "restart": "unless-stopped"
    },
    {
      "name": "searxng",
      "image": "searxng/searxng:latest",
      "environment": {
        "SEARXNG_BASE_URL": "http://searxng:8080/"
      },
      "restart": "unless-stopped"
    }
  ]
}

