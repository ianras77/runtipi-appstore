{
  "services": [
    {
      "name": "perplexia-frontend",
      "image": "itzcrazykns1337/perplexica-frontend:v1.9.3",
      "isMain": true,
      "internalPort": 3000,
      "restart": "unless-stopped",
      "dependsOn": {
        "perplexia-backend": { "condition": "service_started" },
        "searxng": { "condition": "service_started" }
      },
      "environment": {
        "NEXT_PUBLIC_API_URL": "${PERPLEX_BACKEND_URL}",
        "NEXT_PUBLIC_SEARXNG_API_URL": "${SEARXNG_URL}"
      }
    },
    {
      "name": "perplexia-backend",
      "image": "itzcrazykns1337/perplexica-backend:main",
      "internalPort": 3001,
      "restart": "unless-stopped",
      "dependsOn": {
        "searxng": { "condition": "service_started" }
      },
      "environment": {
        "PORT": "3001",
        "SEARXNG_URL": "${SEARXNG_URL}",
        "ORIGIN": "${PERPLEX_FRONTEND_URL}"
      }
    },
    {
      "name": "searxng",
      "image": "searxng/searxng:2025.9.1",
      "internalPort": 8080,
      "restart": "unless-stopped"
    }
  ]
}

