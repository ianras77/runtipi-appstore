{
  "services": [
    {
      "name": "web",
      "image": "itzcrazykns/perplexica-web:latest",
      "isMain": true,
      "internalPort": 3000,
      "restart": "unless-stopped",
      "environment": {
        "API_URL": "http://server:3001"
      },
      "dependsOn": {
        "server": { "condition": "service_started" }
      }
    },
    {
      "name": "server",
      "image": "itzcrazykns/perplexica-server:latest",
      "restart": "unless-stopped",
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_URL": "postgres://perplexica:${POSTGRES_PASSWORD}@db:5432/perplexica",
        "REDIS_URL": "redis://redis:6379"
      },
      "dependsOn": {
        "db": { "condition": "service_started" },
        "redis": { "condition": "service_started" }
      }
    },
    {
      "name": "db",
      "image": "postgres:15-alpine",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "perplexica",
        "POSTGRES_USER": "perplexica",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/postgres", "containerPath": "/var/lib/postgresql/data" }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "restart": "unless-stopped"
    }
  ]
}

