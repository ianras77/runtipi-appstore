{
  "$schema": "../app-info-schema.json",
  "name": "SUB/WAVE",
  "id": "subwave",
  "available": true,
  "short_desc": "Self-hosted internet radio with an AI DJ",
  "description": "Run a shared Icecast radio station from your Navidrome library. Includes the web player, admin console, AI DJ controller, audio analysis, and a persistent broadcast state directory.",
  "author": "Perminder Klair",
  "port": 80,
  "categories": ["media", "music", "ai"],
  "tipi_version": 1,
  "version": "v1.28.0",
  "source": "https://github.com/perminder-klair/subwave",
  "website": "https://www.getsubwave.com/",
  "exposable": true,
  "dynamic_config": true,
  "supported_architectures": ["amd64", "arm64"],
  "form_fields": [
    {
      "type": "text",
      "label": "Admin username",
      "default": "admin",
      "required": true,
      "env_variable": "ADMIN_USER"
    },
    {
      "type": "random",
      "label": "Admin password",
      "min": 32,
      "encoding": "hex",
      "env_variable": "ADMIN_PASS"
    },
    {
      "type": "text",
      "label": "Time zone",
      "default": "Etc/UTC",
      "required": true,
      "env_variable": "TZ"
    }
  ],
  "created_at": 1793491200000,
  "updated_at": 1793491200000
}
