{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "vikunja-mcp",
      "image": "ghcr.io/nkcx/vikunja-mcp-http:latest",
      "isMain": true,
      "internalPort": 8080,
      "addToMainNetwork": true,
      "environment": {
        "VIKUNJA_URL": "${VIKUNJA_URL}",
        "VIKUNJA_API_TOKEN": "${VIKUNJA_API_TOKEN}",
        "VERIFY_SSL": "true",
        "ENABLE_TASK_DELETE": "false",
        "ENABLE_PROJECT_DELETE": "false",
        "ENABLE_LABEL_DELETE": "false",
        "SUPERGATEWAY_API_KEY": "${MCP_AUTH_TOKEN}"
      },
      "entrypoint": [
        "npx",
        "--yes",
        "supergateway@4.2.1"
      ],
      "command": [
        "--stdio",
        "node /opt/vikunja-mcp/dist/index.js",
        "--outputTransport",
        "streamableHttp",
        "--port",
        "8080",
        "--host",
        "0.0.0.0",
        "--stateful",
        "--tools",
        "tasks_list",
        "--tools",
        "tasks_list_all",
        "--tools",
        "task_get",
        "--tools",
        "task_create",
        "--tools",
        "task_update",
        "--tools",
        "task_complete",
        "--tools",
        "projects_list",
        "--tools",
        "project_get",
        "--tools",
        "project_create",
        "--tools",
        "project_update",
        "--tools",
        "labels_list",
        "--tools",
        "label_get",
        "--tools",
        "label_create",
        "--tools",
        "label_update",
        "--tools",
        "label_add_to_task",
        "--tools",
        "label_remove_from_task",
        "--tools",
        "comments_list",
        "--tools",
        "comment_get",
        "--tools",
        "comment_create",
        "--tools",
        "comment_update",
        "--tools",
        "assignees_list",
        "--tools",
        "assignee_add",
        "--tools",
        "assignee_remove",
        "--tools",
        "relation_create",
        "--tools",
        "filter_get",
        "--tools",
        "filter_create",
        "--tools",
        "filter_update",
        "--tools",
        "notifications_list",
        "--tools",
        "notification_get",
        "--tools",
        "subscription_get",
        "--tools",
        "subscription_create",
        "--tools",
        "views_list",
        "--tools",
        "view_get",
        "--tools",
        "view_create",
        "--tools",
        "view_update",
        "--tools",
        "buckets_list",
        "--tools",
        "bucket_create",
        "--tools",
        "bucket_update"
      ]
    }
  ]
}
