{
  "services": [
    {
      "name": "appwrite",
      "image": "appwrite/appwrite:latest",
      "isMain": true,
      "internalPort": 80,
      "restart": "unless-stopped",
      "dependsOn": {
        "mariadb": { "condition": "service_started" },
        "redis": { "condition": "service_started" }
      },
      "environment": {
        "_APP_ENV": "production",
        "_APP_LOCALE": "en",
        "_APP_DOMAIN": "localhost",
        "_APP_DOMAIN_TARGET": "localhost",
        "_APP_OPENSSL_KEY_V1": "${APPWRITE_OPENSSL_KEY}",
        "_DB_HOST": "mariadb",
        "_DB_PORT": "3306",
        "_DB_USER": "appwrite",
        "_DB_PASS": "${APPWRITE_DB_PASSWORD}",
        "_DB_SCHEMA": "appwrite",
        "_REDIS_HOST": "redis",
        "_REDIS_PORT": "6379"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/appwrite/storage", "containerPath": "/storage" }
      ]
    },
    {
      "name": "mariadb",
      "image": "mariadb:10.11",
      "restart": "unless-stopped",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${APPWRITE_DB_PASSWORD}",
        "MYSQL_DATABASE": "appwrite",
        "MYSQL_USER": "appwrite",
        "MYSQL_PASSWORD": "${APPWRITE_DB_PASSWORD}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/appwrite/db", "containerPath": "/var/lib/mysql" }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "restart": "unless-stopped"
    }
  ]
}

