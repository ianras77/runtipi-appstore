{
  "services": [
    {
      "name": "appwrite",
      "image": "appwrite/appwrite:latest",
      "isMain": true,
      "internalPort": 80,
      "environment": {
        "_APP_ENV": "production",
        "_APP_OPTION_FORCE_HTTPS": "disabled",
        "_APP_DB_HOST": "db",
        "_APP_DB_PORT": "3306",
        "_APP_DB_SCHEMA": "appwrite",
        "_APP_DB_USER": "appwrite",
        "_APP_DB_PASS": "${APPWRITE_DB_PASS:-appwritepass}",
        "_APP_REDIS_HOST": "redis",
        "_APP_REDIS_PORT": "6379"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/appwrite/storage", "containerPath": "/storage" }
      ],
      "dependsOn": {
        "db": { "condition": "service_started" },
        "redis": { "condition": "service_started" }
      },
      "restart": "unless-stopped"
    },
    {
      "name": "db",
      "image": "mariadb:11",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${APPWRITE_DB_ROOT:-rootpass}",
        "MYSQL_DATABASE": "appwrite",
        "MYSQL_USER": "appwrite",
        "MYSQL_PASSWORD": "${APPWRITE_DB_PASS:-appwritepass}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/appwrite/db", "containerPath": "/var/lib/mysql" }
      ],
      "restart": "unless-stopped"
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "restart": "unless-stopped"
    }
  ]
}

