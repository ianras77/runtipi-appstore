{
  "services": [
    {
      "name": "appwrite",
      "image": "appwrite/appwrite:1.7.0",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "_APP_ENV",
          "value": "production"
        },
        {
          "key": "_APP_OPENSSL_KEY_V1",
          "value": "${APPWRITE_OPENSSL_KEY_V1}"
        },
        {
          "key": "_APP_DOMAIN",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "_APP_DOMAIN_TARGET",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "_APP_OPTIONS_FORCE_HTTPS",
          "value": "false"
        },
        {
          "key": "_APP_DB_HOST",
          "value": "mariadb"
        },
        {
          "key": "_APP_DB_PORT",
          "value": "3306"
        },
        {
          "key": "_APP_DB_SCHEMA",
          "value": "appwrite"
        },
        {
          "key": "_APP_DB_USER",
          "value": "appwrite"
        },
        {
          "key": "_APP_DB_PASS",
          "value": "${APPWRITE_DB_PASSWORD}"
        },
        {
          "key": "_APP_REDIS_HOST",
          "value": "redis"
        },
        {
          "key": "_APP_REDIS_PORT",
          "value": "6379"
        },
        {
          "key": "_APP_REDIS_USER",
          "value": ""
        },
        {
          "key": "_APP_REDIS_PASS",
          "value": "${APPWRITE_REDIS_PASSWORD}"
        }
      ],
      "dependsOn": {
        "mariadb": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_started"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/appwrite/var",
          "containerPath": "/var/lib/appwrite"
        },
        {
          "hostPath": "${APP_DATA_DIR}/appwrite/uploads",
          "containerPath": "/storage/uploads"
        },
        {
          "hostPath": "${APP_DATA_DIR}/appwrite/config",
          "containerPath": "/usr/src/code/app/config",
          "readOnly": false
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost/v1/health || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "40s"
      }
    },
    {
      "name": "mariadb",
      "image": "mariadb:11.4",
      "environment": [
        {
          "key": "MARIADB_ROOT_PASSWORD",
          "value": "${MARIADB_ROOT_PASSWORD}"
        },
        {
          "key": "MARIADB_DATABASE",
          "value": "appwrite"
        },
        {
          "key": "MARIADB_USER",
          "value": "appwrite"
        },
        {
          "key": "MARIADB_PASSWORD",
          "value": "${APPWRITE_DB_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/mariadb",
          "containerPath": "/var/lib/mysql"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "healthcheck.sh --su=mysql --connect --innodb_initialized",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "redis",
      "image": "redis:7.2",
      "command": [
        "redis-server",
        "--requirepass",
        "${APPWRITE_REDIS_PASSWORD}"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/redis",
          "containerPath": "/data"
        }
      ],
      "restart": "always"
    }
  ],
  "schemaVersion": 2
}