{
  "name": "Appwrite",
  "id": "appwrite",
  "available": true,
  "short_desc": "Self-hosted backend server for web & mobile apps.",
  "author": "community",
  "port": 8250,
  "categories": ["development", "backend"],
  "description": "Appwrite is an open-source backend-as-a-service with auth, DB, storage, functions, and more.",
  "tipi_version": 1,
  "version": "latest",
  "source": "https://github.com/appwrite/appwrite",
  "website": "https://appwrite.io",
  "exposable": true,
  "supported_architectures": ["amd64", "arm64"],
  "form_fields": [
    {
      "type": "password",
      "label": "Database password (MariaDB)",
      "required": true,
      "min": 8,
      "env_variable": "APPWRITE_DB_PASSWORD"
    },
    {
      "type": "random",
      "label": "Appwrite OpenSSL key",
      "required": true,
      "min": 64,
      "encoding": "hex",
      "env_variable": "APPWRITE_OPENSSL_KEY"
    }
  ],
  "dynamic": true
}

