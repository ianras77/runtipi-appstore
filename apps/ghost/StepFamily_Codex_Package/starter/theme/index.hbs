{{!< default}}

<section class="shell archive-header page-surface" data-reveal>
    <p class="eyebrow">Latest writing</p>
    <h1>Notes for building a steadier stepfamily.</h1>
    <p class="archive-description">Practical ideas, calmer scripts, and thoughtful encouragement for step-parents, partners, and families learning how to live together with more trust.</p>
</section>

<section class="section shell" data-reveal>
    <div class="card-grid">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </div>
</section>

{{pagination}}
