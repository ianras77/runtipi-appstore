{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "miniflux-mcp",
      "image": "jwonder/miniflux-mcp:latest",
      "isMain": true,
      "internalPort": 8080,
      "addToMainNetwork": true,
      "environment": {
        "MINIFLUX_URL": "${MINIFLUX_URL}",
        "MINIFLUX_API_KEY": "${MINIFLUX_API_KEY}",
        "MCP_TRANSPORT": "streamable-http",
        "MCP_HTTP_ADDR": ":8080",
        "MCP_HTTP_PATH": "/mcp",
        "MCP_AUTH_TOKEN": "${MCP_AUTH_TOKEN}"
      }
    }
  ]
}
