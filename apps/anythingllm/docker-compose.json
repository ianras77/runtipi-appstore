{
  "services": [
    {
      "name": "anythingllm",
      "image": "mintplexlabs/anythingllm:latest",
      "isMain": true,
      "internalPort": 3001,
      "restart": "unless-stopped",
      "environment": [
        {
          "key": "JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "key": "ALLOW_REGISTRATION",
          "value": "${ALLOW_REGISTRATION}"
        },
        {
          "key": "STORAGE_DIR",
          "value": "/app/server/storage"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/storage",
          "containerPath": "/app/server/storage"
        }
      ]
    }
  ],
  "schemaVersion": 2
}