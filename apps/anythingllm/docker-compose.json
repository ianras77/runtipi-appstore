{
  "services": [
    {
      "name": "anythingllm",
      "image": "mintplexlabs/anythingllm:latest",
      "isMain": true,
      "internalPort": 3001,
      "environment": {
        "JWT_SECRET": "${JWT_SECRET}",
        "STORAGE_DIR": "/app/server/storage",
        "ALLOW_REGISTRATION": "true"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/storage", "containerPath": "/app/server/storage" }
      ],
      "healthCheck": { "path": "/", "interval": 10, "timeout": 5, "retries": 10 }
    }
  ]
}

