{
  "services": [
    {
      "name": "langserve",
      "image": "langchain/langserve:0.1.0",
      "isMain": true,
      "internalPort": 8000,
      "environment": {
        "PORT": "8000",
        "LANGSERVE_APP": "${LANGSERVE_MODULE}"
      },
      "command": ["uvicorn", "${LANGSERVE_MODULE}", "--host", "0.0.0.0", "--port", "8000"],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/app", "containerPath": "/app" }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost:8000/ || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    }
  ]
}

