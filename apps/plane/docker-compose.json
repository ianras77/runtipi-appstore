{
  "services": [
    {
      "name": "proxy",
      "image": "makeplane/plane-proxy:latest",
      "isMain": true,
      "internalPort": 80,
      "restart": "unless-stopped",
      "dependsOn": {
        "web": { "condition": "service_started" },
        "api": { "condition": "service_started" }
      },
      "environment": {
        "WEB_HOST": "web:3000",
        "API_HOST": "api:8000"
      }
    },
    {
      "name": "web",
      "image": "makeplane/plane-frontend:latest",
      "internalPort": 3000,
      "restart": "unless-stopped",
      "dependsOn": {
        "api": { "condition": "service_started" }
      },
      "environment": {
        "NEXT_PUBLIC_API_BASE_URL": "http://api:8000",
        "NEXT_PUBLIC_WEB_URL": "${PLANE_PUBLIC_URL}"
      }
    },
    {
      "name": "api",
      "image": "makeplane/plane-backend:latest",
      "internalPort": 8000,
      "restart": "unless-stopped",
      "dependsOn": {
        "postgres": { "condition": "service_started" },
        "redis": { "condition": "service_started" },
        "minio": { "condition": "service_started" }
      },
      "environment": {
        "PORT": "8000",
        "DATABASE_URL": "postgresql://plane:${PLANE_DB_PASSWORD}@postgres:5432/plane",
        "REDIS_URL": "redis://redis:6379/0",
        "AWS_ENDPOINT_URL": "http://minio:9000",
        "AWS_ACCESS_KEY_ID": "minio",
        "AWS_SECRET_ACCESS_KEY": "miniosecret",
        "AWS_REGION": "us-east-1",
        "AWS_S3_BUCKET_NAME": "uploads",
        "CORS_ALLOWED_ORIGINS": "${PLANE_PUBLIC_URL}"
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16-alpine",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "plane",
        "POSTGRES_USER": "plane",
        "POSTGRES_PASSWORD": "${PLANE_DB_PASSWORD}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/plane/postgres", "containerPath": "/var/lib/postgresql/data" }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "restart": "unless-stopped"
    },
    {
      "name": "minio",
      "image": "minio/minio:latest",
      "internalPort": 9000,
      "restart": "unless-stopped",
      "command": "server /data --console-address ':9090'",
      "environment": {
        "MINIO_ROOT_USER": "minio",
        "MINIO_ROOT_PASSWORD": "miniosecret"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/plane/minio", "containerPath": "/data" }
      ]
    }
  ]
}

