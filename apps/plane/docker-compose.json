{
  "services": [
    {
      "name": "plane",
      "image": "makeplane/plane-space:latest",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "WEB_URL",
          "value": "http://${APP_DOMAIN}"
        },
        {
          "key": "CORS_ALLOWED_ORIGINS",
          "value": "http://${APP_DOMAIN}"
        },
        {
          "key": "DATABASE_URL",
          "value": "postgresql://plane:${PLANE_POSTGRES_PASSWORD}@postgres:5432/plane"
        },
        {
          "key": "REDIS_URL",
          "value": "redis://redis:6379/0"
        },
        {
          "key": "MINIO_ENDPOINT",
          "value": "minio:9000"
        },
        {
          "key": "MINIO_ACCESS_KEY",
          "value": "minio"
        },
        {
          "key": "MINIO_SECRET_KEY",
          "value": "${MINIO_ROOT_PASSWORD}"
        },
        {
          "key": "MINIO_USE_SSL",
          "value": "false"
        },
        {
          "key": "DJANGO_SECRET_KEY",
          "value": "${PLANE_SECRET_KEY}"
        }
      ],
      "dependsOn": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_started"
        },
        "minio": {
          "condition": "service_started"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/plane/uploads",
          "containerPath": "/uploads"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost/health || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "40s"
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16",
      "environment": [
        {
          "key": "POSTGRES_DB",
          "value": "plane"
        },
        {
          "key": "POSTGRES_USER",
          "value": "plane"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${PLANE_POSTGRES_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "pg_isready -U plane -d plane",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "redis",
      "image": "redis:7.2",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/redis",
          "containerPath": "/data"
        }
      ],
      "restart": "always"
    },
    {
      "name": "minio",
      "image": "minio/minio:RELEASE.2024-12-07T00-00-00Z",
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "environment": [
        {
          "key": "MINIO_ROOT_USER",
          "value": "minio"
        },
        {
          "key": "MINIO_ROOT_PASSWORD",
          "value": "${MINIO_ROOT_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/minio",
          "containerPath": "/data"
        }
      ],
      "addPorts": [
        {
          "containerPort": 9001,
          "hostPort": 0,
          "tcp": true,
          "udp": false
        }
      ],
      "restart": "always"
    }
  ],
  "schemaVersion": 2
}