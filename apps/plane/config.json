{
  "name": "Plane",
  "id": "plane",
  "available": true,
  "short_desc": "Open-source project & issue tracking.",
  "author": "community",
  "port": 8280,
  "categories": ["project-management", "productivity"],
  "description": "Plane is a simple, extensible project management tool (issues, cycles, roadmaps). This setup uses the official containers (proxy, web, api) plus Postgres, Redis and MinIO.",
  "tipi_version": 1,
  "version": "latest",
  "source": "https://github.com/makeplane/plane",
  "website": "https://plane.so",
  "exposable": true,
  "supported_architectures": ["amd64", "arm64"],
  "form_fields": [
    { "type": "random", "label": "Postgres password", "required": true, "min": 24, "encoding": "hex", "env_variable": "PLANE_DB_PASSWORD" },
    { "type": "text", "label": "Public URL (used by frontend CORS)", "required": false, "default": "http://localhost:8280", "env_variable": "PLANE_PUBLIC_URL" }
  ],
  "dynamic": true
}

