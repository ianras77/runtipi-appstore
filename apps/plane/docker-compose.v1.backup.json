{
  "services": [
    {
      "name": "plane",
      "image": "makeplane/plane-space:latest",
      "isMain": true,
      "internalPort": 80,
      "environment": {
        "WEB_URL": "http://${APP_DOMAIN}",
        "CORS_ALLOWED_ORIGINS": "http://${APP_DOMAIN}",
        "DATABASE_URL": "postgresql://plane:${PLANE_POSTGRES_PASSWORD}@postgres:5432/plane",
        "REDIS_URL": "redis://redis:6379/0",
        "MINIO_ENDPOINT": "minio:9000",
        "MINIO_ACCESS_KEY": "minio",
        "MINIO_SECRET_KEY": "${MINIO_ROOT_PASSWORD}",
        "MINIO_USE_SSL": "false",
        "DJANGO_SECRET_KEY": "${PLANE_SECRET_KEY}"
      },
      "dependsOn": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_started"
        },
        "minio": {
          "condition": "service_started"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/plane/uploads",
          "containerPath": "/uploads"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost/health || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "40s"
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16",
      "environment": {
        "POSTGRES_DB": "plane",
        "POSTGRES_USER": "plane",
        "POSTGRES_PASSWORD": "${PLANE_POSTGRES_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "pg_isready -U plane -d plane",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "redis",
      "image": "redis:7.2",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/redis",
          "containerPath": "/data"
        }
      ],
      "restart": "always"
    },
    {
      "name": "minio",
      "image": "minio/minio:RELEASE.2024-12-07T00-00-00Z",
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "environment": {
        "MINIO_ROOT_USER": "minio",
        "MINIO_ROOT_PASSWORD": "${MINIO_ROOT_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/minio",
          "containerPath": "/data"
        }
      ],
      "addPorts": [
        {
          "containerPort": 9001,
          "hostPort": 0,
          "tcp": true,
          "udp": false
        }
      ],
      "restart": "always"
    }
  ]
}