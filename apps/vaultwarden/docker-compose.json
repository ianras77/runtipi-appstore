{
  "services": [
    {
      "name": "vaultwarden",
      "image": "vaultwarden/server:1.33.2",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "WEBSOCKET_ENABLED",
          "value": "true"
        },
        {
          "key": "ADMIN_TOKEN",
          "value": "${VAULTWARDEN_ADMIN_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ],
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2
}