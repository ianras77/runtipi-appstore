{
  "$schema": "../dynamic-compose-schema.json",
  "schema": "2",
  "services": [
    {
      "name": "cheshire-cat-ai",
      "image": "ghcr.io/cheshire-cat-ai/core:1.9.2",
      "isMain": true,
      "internalPort": 80,
      "environment": {
        "CCAT_QDRANT_HOST": "qdrant",
        "CCAT_QDRANT_PORT": "6333"
      },
      "dependsOn": {
        "qdrant": {
          "condition": "service_started"
        },
        "redis": {
          "condition": "service_started"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/static",
          "containerPath": "/app/cat/static"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/plugins",
          "containerPath": "/app/cat/plugins"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/data",
          "containerPath": "/app/cat/data"
        }
      ]
    },
    {
      "name": "qdrant",
      "image": "qdrant/qdrant:v1.12.0",
      "internalPort": 6333,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/qdrant",
          "containerPath": "/qdrant/storage"
        }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7.2-alpine",
      "internalPort": 6379,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/redis-data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}