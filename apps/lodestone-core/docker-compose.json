{
  "$schema": "../dynamic-compose-schema.json",
  "schema": "2",
  "services": [
    {
      "name": "lodestone-core",
      "image": "ghcr.io/lodestone-team/lodestone_core",
      "isMain": true,
      "internalPort": 16662,
      "addPorts": [
        {
          "hostPort": "25565-25575",
          "containerPort": "25565-25575"
        }
      ],
      "user": "0:0",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/lodestone-data",
          "containerPath": "/root/.lodestone"
        }
      ]
    }
  ]
}
