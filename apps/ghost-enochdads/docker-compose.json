{
  "services": [
    {
      "$schema": "../dynamic-compose-schema.json",
      "schema": "2",
      "name": "ghost-ed",
      "image": "ghost:6.14.0",
      "environment": [
        {
          "key": "database__client",
          "value": "mysql"
        },
        {
          "key": "database__connection__host",
          "value": "ghost-eddb"
        },
        {
          "key": "database__connection__user",
          "value": "tipi"
        },
        {
          "key": "database__connection__password",
          "value": "${GHOST_DATABASE_PASSWORD}"
        },
        {
          "key": "database__connection__database",
          "value": "ghost-tipi"
        },
        {
          "key": "url",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "mail__transport",
          "value": "SMTP"
        },
        {
          "key": "mail__options__service",
          "value": "${GHOST_MAIL_SERVICE}"
        },
        {
          "key": "mail__options__host",
          "value": "${GHOST_MAIL_HOST}"
        },
        {
          "key": "mail__options__port",
          "value": "${GHOST_MAIL_PORT}"
        },
        {
          "key": "mail__options__auth__user",
          "value": "${GHOST_MAIL_USER}"
        },
        {
          "key": "mail__options__auth__pass",
          "value": "${GHOST_MAIL_PASSWORD}"
        },
        {
          "key": "mail__from",
          "value": "${GHOST_MAIL_FROM}"
        },
        {
          "key": "mail__options__secure",
          "value": "${GHOST_MAIL_SECURE}"
        }
      ],
      "internalPort": 2368,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/content",
          "containerPath": "/var/lib/ghost/content",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/tmp",
          "containerPath": "/tmp/",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "dependsOn": {
        "ghost-eddb": {
          "condition": "service_started"
        }
      },
      "isMain": true
    },
    {
      "name": "ghost-eddb",
      "image": "mariadb:12.1.2",
      "environment": [
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "value": "${GHOST_DATABASE_PASSWORD}"
        },
        {
          "key": "MYSQL_USER",
          "value": "tipi"
        },
        {
          "key": "MYSQL_PASSWORD",
          "value": "${GHOST_DATABASE_PASSWORD}"
        },
        {
          "key": "MYSQL_DATABASE",
          "value": "ghost-tipi"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/var/lib/mysql",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ],
  "schemaVersion": 2
}
