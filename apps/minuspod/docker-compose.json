{
  "services": [
    {
      "name": "minuspod",
      "image": "ttlequals0/minuspod:2.100.18-cpu",
      "isMain": true,
      "internalPort": 8000,
      "environment": [
        {"key":"LLM_PROVIDER","value":"${LLM_PROVIDER}"},
        {"key":"ANTHROPIC_API_KEY","value":"${ANTHROPIC_API_KEY}"},
        {"key":"OPENROUTER_API_KEY","value":"${OPENROUTER_API_KEY}"},
        {"key":"OPENAI_API_KEY","value":"${OPENAI_API_KEY}"},
        {"key":"OPENAI_BASE_URL","value":"${OPENAI_BASE_URL}"},
        {"key":"OPENAI_MODEL","value":"${OPENAI_MODEL}"},
        {"key":"TYPESAFE_API_KEY","value":"${TYPESAFE_API_KEY}"},
        {"key":"SYSTEMONE_API_KEY","value":"${SYSTEMONE_API_KEY}"},
        {"key":"SYSTEMONE_BASE_URL","value":"${SYSTEMONE_BASE_URL}"},
        {"key":"WHISPER_BACKEND","value":"${WHISPER_BACKEND:-local}"},
        {"key":"WHISPER_MODEL","value":"${WHISPER_MODEL:-tiny}"},
        {"key":"WHISPER_DEVICE","value":"cpu"},
        {"key":"WHISPER_COMPUTE_TYPE","value":"${WHISPER_COMPUTE_TYPE:-auto}"},
        {"key":"WHISPER_LANGUAGE","value":"${WHISPER_LANGUAGE:-en}"},
        {"key":"WHISPER_API_BASE_URL","value":"${WHISPER_API_BASE_URL}"},
        {"key":"WHISPER_API_KEY","value":"${WHISPER_API_KEY}"},
        {"key":"WHISPER_API_MODEL","value":"${WHISPER_API_MODEL:-whisper-1}"},
        {"key":"BASE_URL","value":"https://${APP_DOMAIN}"},
        {"key":"MINUSPOD_PORT","value":"8000"},
        {"key":"MINUSPOD_MASTER_PASSPHRASE","value":"${MINUSPOD_MASTER_PASSPHRASE}"},
        {"key":"MINUSPOD_REQUIRE_AUTH","value":"true"},
        {"key":"MINUSPOD_ALLOW_PUBLIC_PROCESSING","value":"false"},
        {"key":"MINUSPOD_TRUSTED_PROXY_COUNT","value":"1"},
        {"key":"SESSION_COOKIE_SECURE","value":"auto"},
        {"key":"SESSION_COOKIE_SAMESITE","value":"Strict"},
        {"key":"MINUSPOD_ENABLE_HSTS","value":"false"},
        {"key":"RATE_LIMIT_STORAGE_URI","value":"memory-threadsafe://"},
        {"key":"MAX_AUDIO_DOWNLOAD_MB","value":"${MAX_AUDIO_DOWNLOAD_MB:-500}"}
      ],
      "volumes": [
        {"hostPath":"${APP_DATA_DIR}/data","containerPath":"/app/data"}
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
