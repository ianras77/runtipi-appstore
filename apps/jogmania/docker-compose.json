{
  "$schema": "../dynamic-compose-schema.json",
  "schema": "2",
  "services": [
    {
      "name": "jogmania-web",
      "image": "node:20-alpine",
      "isMain": true,
      "internalPort": 3000,
      "workingDir": "/repo",
      "command": [
        "sh",
        "-c",
        "corepack enable && pnpm install && pnpm --filter @jogmania/web dev --hostname 0.0.0.0"
      ],
      "environment": {
        "NEXT_PUBLIC_API_BASE_URL": "http://jogmania-api:8000"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/repo",
          "containerPath": "/repo"
        }
      ],
      "dependsOn": [
        "jogmania-api"
      ]
    },
    {
      "name": "jogmania-api",
      "image": "python:3.11-slim",
      "workingDir": "/app",
      "command": [
        "sh",
        "-c",
        "pip install -r requirements.txt && uvicorn app.main:app --host 0.0.0.0 --port 8000"
      ],
      "environment": {
        "POSTGRES_HOST": "jogmania-db",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "jogmania",
        "POSTGRES_PASSWORD": "${JOGMANIA_DB_PASSWORD}",
        "POSTGRES_DB": "${JOGMANIA_DB_NAME}",
        "REDIS_URL": "redis://jogmania-redis:6379/0",
        "MINIO_ENDPOINT": "jogmania-minio:9000",
        "MINIO_ACCESS_KEY": "${JOGMANIA_MINIO_USER}",
        "MINIO_SECRET_KEY": "${JOGMANIA_MINIO_PASSWORD}",
        "MINIO_SECURE": "false",
        "S3_BUCKET": "jogmania-exports",
        "JWT_SECRET": "${JOGMANIA_JWT_SECRET}",
        "LLM_BASE_URL": "${LLM_BASE_URL}",
        "LLM_API_KEY": "${LLM_API_KEY}",
        "LLM_MODEL": "${LLM_MODEL}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/api",
          "containerPath": "/app"
        }
      ],
      "dependsOn": [
        "jogmania-db",
        "jogmania-redis",
        "jogmania-minio"
      ]
    },
    {
      "name": "jogmania-db",
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_USER": "jogmania",
        "POSTGRES_PASSWORD": "${JOGMANIA_DB_PASSWORD}",
        "POSTGRES_DB": "${JOGMANIA_DB_NAME}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "name": "jogmania-redis",
      "image": "redis:7-alpine"
    },
    {
      "name": "jogmania-minio",
      "image": "minio/minio:RELEASE.2024-12-13T23-44-13Z",
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "environment": {
        "MINIO_ROOT_USER": "${JOGMANIA_MINIO_USER}",
        "MINIO_ROOT_PASSWORD": "${JOGMANIA_MINIO_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/minio",
          "containerPath": "/data"
        }
      ],
      "addPorts": [
        {
          "containerPort": 9001,
          "hostPort": 9001,
          "interface": "127.0.0.1"
        }
      ]
    }
  ],
  "schemaVersion": 2
}
