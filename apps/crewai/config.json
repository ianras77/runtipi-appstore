{
  "name": "CrewAI Studio (+ Qdrant & Redis)",
  "id": "crewai",
  "available": true,
  "short_desc": "Design and run CrewAI agents. Bundled with Qdrant vector DB and Redis cache.",
  "author": "rasies",
  "port": 8501,
  "categories": ["ai"],
  "description": "CrewAI Studio with built-in Qdrant (vector database) and Redis (cache/queues) so you can do RAG and fast state without extra setup. Uses internal networking; only the Studio is exposed.",
  "tipi_version": 2,
  "version": "1.1.0",
  "source": "https://github.com/strnad/CrewAI-Studio",
  "website": "https://docs.crewai.com",
  "exposable": true,
  "https": true,
  "supported_architectures": ["amd64"],
  "dynamic": true,
  "min_tipi_version": "v3.2.0",
  "form_fields": [
    {
      "type": "text",
      "label": "OpenAI-compatible Base URL (optional) — e.g. http://192.168.1.12:8080/v1 (LocalAI) or https://api.openai.com/v1",
      "placeholder": "http://192.168.1.12:8080/v1",
      "required": false,
      "env_variable": "OPENAI_BASE_URL"
    },
    {
      "type": "password",
      "label": "OpenAI API Key (or dummy key for LocalAI/OpenAI-compatible backends)",
      "required": false,
      "env_variable": "OPENAI_API_KEY"
    },
    {
      "type": "text",
      "label": "Ollama Base URL (optional) — e.g. http://192.168.1.12:11434",
      "placeholder": "http://192.168.1.12:11434",
      "required": false,
      "env_variable": "OLLAMA_BASE_URL"
    },
    {
      "type": "password",
      "label": "Anthropic API Key (optional)",
      "required": false,
      "env_variable": "ANTHROPIC_API_KEY"
    },
    {
      "type": "password",
      "label": "Groq API Key (optional)",
      "required": false,
      "env_variable": "GROQ_API_KEY"
    },
    {
      "type": "text",
      "label": "LM Studio Base URL (optional) — e.g. http://localhost:1234/v1",
      "placeholder": "http://localhost:1234/v1",
      "required": false,
      "env_variable": "LMSTUDIO_BASE_URL"
    },
    {
      "type": "text",
      "label": "Qdrant collection name",
      "required": false,
      "env_variable": "QDRANT_COLLECTION",
      "default": "crewai"
    },
    {
      "type": "password",
      "label": "Qdrant API key (optional)",
      "required": false,
      "env_variable": "QDRANT_API_KEY"
    },
    {
      "type": "random",
      "label": "Redis password (optional)",
      "required": false,
      "min": 24,
      "env_variable": "REDIS_PASSWORD"
    }
    ]
}

