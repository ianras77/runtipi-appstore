{
  "services": [
    {
      "name": "crewai-studio",
      "image": "tham0nk/crewai-studio:latest",
      "isMain": true,
      "internalPort": 8501,
      "restart": "unless-stopped",
      "environment": {
        "OPENAI_BASE_URL": "${OPENAI_BASE_URL}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OLLAMA_BASE_URL": "${OLLAMA_BASE_URL}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "GROQ_API_KEY": "${GROQ_API_KEY}",
        "LMSTUDIO_BASE_URL": "${LMSTUDIO_BASE_URL}",
        "QDRANT_URL": "http://qdrant:6333",
        "QDRANT_GRPC_URL": "http://qdrant:6334",
        "QDRANT_API_KEY": "${QDRANT_API_KEY}",
        "QDRANT_COLLECTION": "${QDRANT_COLLECTION}",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "REDIS_PASSWORD": "${REDIS_PASSWORD}",
        "REDIS_URL": "redis://:${REDIS_PASSWORD}@redis:6379/0",
        "PORT": "8501",
        "STREAMLIT_SERVER_PORT": "8501"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "dependsOn": [
        { "name": "qdrant", "condition": "service_started" },
        { "name": "redis", "condition": "service_started" }
      ]
    },
    {
      "name": "qdrant",
      "image": "qdrant/qdrant:1.12.4",
      "restart": "unless-stopped",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/qdrant/storage",
          "containerPath": "/qdrant/storage"
        }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7.2-alpine",
      "restart": "unless-stopped",
      "command": "sh -lc 'exec redis-server --appendonly yes ${REDIS_PASSWORD:+--requirepass $REDIS_PASSWORD}'",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/redis",
          "containerPath": "/data"
        }
      ]
    }
  ]
}

