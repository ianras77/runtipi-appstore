  "version": "latest",
  "source": "https://github.com/open-webui/open-terminal",
  "website": "https://docs.openwebui.com/features/extensibility/open-terminal/",
  "exposable": true,
  "dynamic_config": true,
  "supported_architectures": ["arm64", "amd64"],
