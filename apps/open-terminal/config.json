      "env_variable": "OPEN_TERMINAL_API_KEY"
    },
    {
      "type": "boolean",
      "label": "Enable Interactive Terminal",
      "hint": "Disable if you only want command execution and file APIs.",
      "required": false,
      "default": true,
      "env_variable": "OPEN_TERMINAL_ENABLE_TERMINAL"
    },
    {
      "type": "number",
      "label": "Max Terminal Sessions",
      "hint": "Limits concurrent interactive sessions.",
      "required": false,
      "default": 16,
      "min": 1,
      "max": 128,
      "env_variable": "OPEN_TERMINAL_MAX_SESSIONS"
    }
  ],
