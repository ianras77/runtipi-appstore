{
  "services": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "isMain": true,
      "internalPort": 8080,
      "environment": {
        "LEAN_DB_HOST": "mysql",
        "LEAN_DB_USER": "lean",
        "LEAN_DB_PASSWORD": "${MYSQL_PASSWORD}",
        "LEAN_DB_DATABASE": "leantime",
        "LEAN_SESSION_PASSWORD": "${SESSION_PASSWORD}",
        "LEAN_APP_URL": "https://${APP_DOMAIN}"
      },
      "dependsOn": [{ "name": "mysql", "condition": "service_healthy" }],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/public_userfiles", "containerPath": "/var/www/html/public/userfiles" },
        { "hostPath": "${APP_DATA_DIR}/userfiles", "containerPath": "/var/www/html/userfiles" },
        { "hostPath": "${APP_DATA_DIR}/plugins", "containerPath": "/var/www/html/app/Plugins" },
        { "hostPath": "${APP_DATA_DIR}/logs", "containerPath": "/var/www/html/storage/logs" }
      ],
      "healthCheck": { "path": "/", "interval": 10, "timeout": 5, "retries": 30 }
    },
    {
      "name": "mysql",
      "image": "mysql:8.4",
      "environment": {
        "MYSQL_DATABASE": "leantime",
        "MYSQL_USER": "lean",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
        "MYSQL_ROOT_PASSWORD": "${MYSQL_PASSWORD}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/mysql", "containerPath": "/var/lib/mysql" }
      ],
      "healthCheck": { "cmd": ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p${MYSQL_PASSWORD}"], "interval": 10, "timeout": 5, "retries": 20 }
    }
  ]
}

