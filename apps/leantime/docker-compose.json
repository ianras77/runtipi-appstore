{
  "services": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "isMain": true,
      "internalPort": 8080,
      "restart": "unless-stopped",
      "dependsOn": {
        "mysql": { "condition": "service_started" }
      },
      "environment": {
        "LEANTIME_DB_HOST": "mysql",
        "LEANTIME_DB_DATABASE": "leantime",
        "LEANTIME_DB_USERNAME": "leantime",
        "LEANTIME_DB_PASSWORD": "${LEANTIME_DB_PASSWORD}",
        "LEANTIME_NAME": "${LEANTIME_NAME}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/leantime/userfiles", "containerPath": "/var/www/html/public/userfiles" }
      ]
    },
    {
      "name": "mysql",
      "image": "mysql:8.0",
      "restart": "unless-stopped",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${LEANTIME_DB_ROOT_PASSWORD}",
        "MYSQL_DATABASE": "leantime",
        "MYSQL_USER": "leantime",
        "MYSQL_PASSWORD": "${LEANTIME_DB_PASSWORD}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/leantime/mysql", "containerPath": "/var/lib/mysql" }
      ]
    }
  ]
}

