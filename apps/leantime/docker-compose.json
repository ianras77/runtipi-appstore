{
  "services": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "isMain": true,
      "internalPort": 8080,
      "restart": "unless-stopped",
      "environment": {
        "LEANTIME_DB_HOST": "mysql",
        "LEANTIME_DB_USER": "lean",
        "LEANTIME_DB_PASSWORD": "${MYSQL_PASSWORD}",
        "LEANTIME_DB_DATABASE": "leantime",
        "LEANTIME_APP_URL": "${LEANTIME_APP_URL}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/public_userfiles", "containerPath": "/var/www/html/public/userfiles" },
        { "hostPath": "${APP_DATA_DIR}/userfiles", "containerPath": "/var/www/html/userfiles" },
        { "hostPath": "${APP_DATA_DIR}/plugins", "containerPath": "/var/www/html/app/Plugins" },
        { "hostPath": "${APP_DATA_DIR}/logs", "containerPath": "/var/www/html/storage/logs" }
      ],
      "dependsOn": {
        "mysql": { "condition": "service_started" }
      }
    },
    {
      "name": "mysql",
      "image": "mysql:8.4",
      "restart": "unless-stopped",
      "environment": {
        "MYSQL_DATABASE": "leantime",
        "MYSQL_USER": "lean",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
        "MYSQL_ROOT_PASSWORD": "${MYSQL_PASSWORD}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/mysql", "containerPath": "/var/lib/mysql" }
      ]
    }
  ]
}

