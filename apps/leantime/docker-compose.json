{
  "services": [
    {
      "name": "leantime",
      "image": "leantime/leantime:3.5.12",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "LEAN_DB_HOST",
          "value": "mysql"
        },
        {
          "key": "LEAN_DB_USER",
          "value": "leantime"
        },
        {
          "key": "LEAN_DB_PASSWORD",
          "value": "${MYSQL_PASSWORD}"
        },
        {
          "key": "LEAN_DB_DATABASE",
          "value": "leantime"
        },
        {
          "key": "LEAN_APP_URL",
          "value": "http://${APP_DOMAIN}"
        }
      ],
      "dependsOn": {
        "mysql": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/leantime/userfiles",
          "containerPath": "/var/www/html/public/userfiles"
        },
        {
          "hostPath": "${APP_DATA_DIR}/leantime/storage",
          "containerPath": "/var/www/html/storage"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "mysql",
      "image": "mysql:8.0",
      "environment": [
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "value": "${MYSQL_ROOT_PASSWORD}"
        },
        {
          "key": "MYSQL_DATABASE",
          "value": "leantime"
        },
        {
          "key": "MYSQL_USER",
          "value": "leantime"
        },
        {
          "key": "MYSQL_PASSWORD",
          "value": "${MYSQL_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/mysql",
          "containerPath": "/var/lib/mysql"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "mysqladmin ping -h localhost -p${MYSQL_ROOT_PASSWORD}",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    }
  ],
  "schemaVersion": 2
}