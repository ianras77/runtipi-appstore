{
  "services": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "isMain": true,
      "internalPort": 8080,
      "environment": {
        "LEANTIME_DB_HOST": "db",
        "LEANTIME_DB_USER": "leantime",
        "LEANTIME_DB_PASSWORD": "${LEANTIME_DB_PASS:-leantimepass}",
        "LEANTIME_DB_DATABASE": "leantime",
        "LEANTIME_DB_PORT": "3306"
      },
      "dependsOn": { "db": { "condition": "service_started" } },
      "restart": "unless-stopped"
    },
    {
      "name": "db",
      "image": "mariadb:11",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${LEANTIME_DB_ROOT:-rootpass}",
        "MYSQL_DATABASE": "leantime",
        "MYSQL_USER": "leantime",
        "MYSQL_PASSWORD": "${LEANTIME_DB_PASS:-leantimepass}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/leantime/db", "containerPath": "/var/lib/mysql" }
      ],
      "restart": "unless-stopped"
    }
  ]
}

