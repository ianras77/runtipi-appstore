{
  "services": [
    {
      "name": "leantime",
      "image": "leantime/leantime:3.5.12",
      "isMain": true,
      "internalPort": 80,
      "environment": {
        "LEAN_DB_HOST": "mysql",
        "LEAN_DB_USER": "leantime",
        "LEAN_DB_PASSWORD": "${MYSQL_PASSWORD}",
        "LEAN_DB_DATABASE": "leantime",
        "LEAN_APP_URL": "http://${APP_DOMAIN}"
      },
      "dependsOn": {
        "mysql": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/leantime/userfiles",
          "containerPath": "/var/www/html/public/userfiles"
        },
        {
          "hostPath": "${APP_DATA_DIR}/leantime/storage",
          "containerPath": "/var/www/html/storage"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "mysql",
      "image": "mysql:8.0",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${MYSQL_ROOT_PASSWORD}",
        "MYSQL_DATABASE": "leantime",
        "MYSQL_USER": "leantime",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/mysql",
          "containerPath": "/var/lib/mysql"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "mysqladmin ping -h localhost -p${MYSQL_ROOT_PASSWORD}",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    }
  ]
}