{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "networks": [
    {
      "name": "runtipi_tipi_main_network",
      "external": true
    }
  ],
  "services": [
    {
      "name": "cheshire-rasies",
      "image": "ghcr.io/cheshire-cat-ai/core:1.9.2",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "CCAT_QDRANT_HOST",
          "value": "qdrant-rasies"
        },
        {
          "key": "CCAT_QDRANT_PORT",
          "value": "6333"
        },
        {
          "key": "CCAT_CORE_HOST",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "CCAT_CORE_PORT",
          "value": "443"
        },
        {
          "key": "CCAT_CORE_USE_SECURE_PROTOCOLS",
          "value": "true"
        },
        {
          "key": "CCAT_HTTPS_PROXY_MODE",
          "value": "true"
        },
        {
          "key": "CCAT_CORS_ALLOWED_ORIGINS",
          "value": "*"
        },
        {
          "key": "CCAT_CORS_FORWARDED_ALLOW_IPS",
          "value": "*"
        },
        {
          "key": "CCAT_LOG_LEVEL",
          "value": "INFO"
        }
      ],
      "dependsOn": {
        "qdrant-rasies": {
          "condition": "service_healthy"
        },
        "redis-rasies": {
          "condition": "service_healthy"
        },
        "postgres-rasies": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/static",
          "containerPath": "/app/cat/static"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/plugins",
          "containerPath": "/app/cat/plugins"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/data",
          "containerPath": "/app/cat/data"
        }
      ],
      "healthCheck": {
        "test": "wget -qO- http://localhost/healthz || exit 1",
        "interval": "30s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "30s"
      }
    },
    {
      "name": "qdrant-rasies",
      "image": "qdrant/qdrant:v1.16.3",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/qdrant",
          "containerPath": "/qdrant/storage"
        }
      ],
      "ulimits": {
        "nofile": {
          "soft": 524288,
          "hard": 524288
        }
      },
      "healthCheck": {
        "test": "wget -qO- http://localhost:6333/healthz || exit 1",
        "interval": "15s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "20s"
      }
    },
    {
      "name": "redis-rasies",
      "image": "redis:8.4.0-alpine",
      "command": [
        "redis-server",
        "--save", "60", "1000",
        "--appendonly", "yes",
        "--appendfsync", "everysec"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/redis",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "test": "redis-cli ping | grep -q PONG || exit 1",
        "interval": "15s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "10s"
      }
    },
    {
      "name": "postgres-rasies",
      "image": "pgvector/pgvector:pg17",
      "environment": [
        {
          "key": "POSTGRES_DB",
          "value": "cheshire"
        },
        {
          "key": "POSTGRES_USER",
          "value": "cheshire"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${CHESHIRE_RASIES_POSTGRES_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U cheshire -d cheshire || exit 1",
        "interval": "15s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "20s"
      }
    }
  ]
}
