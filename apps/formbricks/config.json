{
  "$schema": "../app-info-schema.json",
  "name": "Formbricks",
  "id": "formbricks",
  "available": true,
  "short_desc": "Self-hosted surveys, forms, and product feedback",
  "description": "Formbricks is an open-source survey and experience management platform. Create in-product, website, link, and email surveys, collect feedback, and review responses in a self-hosted workspace. This Runtipi package includes the current application, PostgreSQL, Redis-compatible Valkey, authorization service, analytics Cube, Hub API and worker, and the required database migrations.",
  "author": "Formbricks",
  "port": 3000,
  "categories": ["data", "utilities"],
  "tipi_version": 1,
  "version": "6.1.2",
  "source": "https://github.com/formbricks/formbricks",
  "website": "https://formbricks.com/",
  "exposable": true,
  "dynamic_config": true,
  "supported_architectures": ["amd64"],
  "form_fields": [
    {"type": "random", "label": "PostgreSQL password", "min": 32, "encoding": "hex", "env_variable": "POSTGRES_PASSWORD"},
    {"type": "random", "label": "Formbricks encryption key", "min": 32, "encoding": "hex", "env_variable": "ENCRYPTION_KEY"},
    {"type": "random", "label": "Authentication secret", "min": 32, "encoding": "hex", "env_variable": "BETTER_AUTH_SECRET"},
    {"type": "random", "label": "Cron API secret", "min": 32, "encoding": "hex", "env_variable": "CRON_SECRET"},
    {"type": "random", "label": "Hub API key", "min": 32, "encoding": "hex", "env_variable": "HUB_API_KEY"},
    {"type": "random", "label": "Cube API secret", "min": 32, "encoding": "hex", "env_variable": "CUBEJS_API_SECRET"},
    {"type": "random", "label": "SpiceDB shared token", "min": 32, "encoding": "hex", "env_variable": "AUTHZED_TOKEN"},
    {"type": "random", "label": "SpiceDB database password", "min": 32, "encoding": "hex", "env_variable": "AUTHZED_DATABASE_PASSWORD"},
    {"type": "email", "label": "Sender email address", "required": false, "env_variable": "MAIL_FROM"},
    {"type": "text", "label": "Sender display name", "default": "Formbricks", "required": false, "env_variable": "MAIL_FROM_NAME"},
    {"type": "text", "label": "SMTP server", "required": false, "env_variable": "SMTP_HOST"},
    {"type": "number", "label": "SMTP port", "default": 587, "required": false, "env_variable": "SMTP_PORT"},
    {"type": "text", "label": "SMTP username", "required": false, "env_variable": "SMTP_USER"},
    {"type": "password", "label": "SMTP password", "required": false, "env_variable": "SMTP_PASSWORD"},
    {"type": "boolean", "label": "SMTP requires authentication", "default": true, "env_variable": "SMTP_AUTHENTICATED"},
    {"type": "boolean", "label": "SMTP uses implicit TLS", "default": false, "env_variable": "SMTP_SECURE_ENABLED"},
    {"type": "boolean", "label": "SMTP requires STARTTLS", "default": true, "env_variable": "SMTP_REQUIRE_TLS"}
  ]
}
