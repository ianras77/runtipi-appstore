// config.json
{
  "name": "Grist",
  "id": "grist",
  "available": true,
  "exposable": true,
  "dynamic_config": true,
  "tipi_version": 32,
  "version": "latest",
  "description": "Grist is a modern relational spreadsheet. It combines the flexibility of a spreadsheet with the robustness of a database to organize your data and make you more productive.",
  "short_desc": "Grist is the evolution of spreadsheets.",
  "author": "https://github.com/gristlabs",
  "source": "https://github.com/gristlabs/grist-core",
  "website": "https://www.getgrist.com/",
  "categories": ["utilities"],
  "supported_architectures": ["arm64", "amd64"],
  "form_fields": [
    {
      "type": "select",
      "label": "Sandbox Flavor",
      "required": true,
      "options": [
        { "label": "unsandboxed", "value": "unsandboxed" },
        { "label": "gvisor",      "value": "gvisor" }
      ],
      "env_variable": "GRIST_SANDBOX_FLAVOR"
    },
    {
      "type": "text",
      "label": "Admin Email",
      "required": true,
      "env_variable": "GRIST_DEFAULT_EMAIL"
    },
    {
      "type": "text",
      "label": "Session Secret",
      "required": true,
      "env_variable": "GRIST_SESSION_SECRET"
    },
    {
      "type": "boolean",
      "label": "Require Login",
      "required": false,
      "env_variable": "GRIST_FORCE_LOGIN",
      "default": true
    },
    {
      "type": "text",
      "label": "Auth Header",
      "required": false,
      "env_variable": "GRIST_FORWARD_AUTH_HEADER",
      "default": "X-Forwarded-User"
    },
    {
      "type": "text",
      "label": "Login Path",
      "required": false,
      "env_variable": "GRIST_FORWARD_AUTH_LOGIN_PATH",
      "default": "/auth/login"
    },
    {
      "type": "text",
      "label": "Logout Path",
      "required": false,
      "env_variable": "GRIST_FORWARD_AUTH_LOGOUT_PATH",
      "default": "/auth/logout"
    }
  ],
