{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "searxng-mcp",
      "image": "isokoliuk/mcp-searxng:2.6.0",
      "isMain": true,
      "internalPort": 3000,
      "addToMainNetwork": true,
      "environment": {
        "SEARXNG_URL": "${SEARXNG_URL}",
        "MCP_HTTP_PORT": "3000",
        "MCP_HTTP_HOST": "0.0.0.0",
        "MCP_HTTP_HARDEN": "true",
        "MCP_HTTP_AUTH_TOKEN": "${MCP_HTTP_AUTH_TOKEN}",
        "MCP_HTTP_ALLOWED_ORIGINS": "${MCP_HTTP_ALLOWED_ORIGINS}",
        "MCP_HTTP_ALLOWED_HOSTS": "${MCP_HTTP_ALLOWED_HOSTS}",
        "MCP_HTTP_ALLOW_PRIVATE_URLS": "false"
      }
    }
  ]
}
