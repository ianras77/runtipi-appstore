{
  "$schema": "../app-info-schema.json",
  "id": "mcp-karakeep",
  "name": "Karakeep MCP",
  "available": true,
  "deprecated": false,
  "port": 3000,
  "description": "Private HTTP MCP bridge for the Karakeep API with bearer authentication. Keep it on the Runtipi app network.",
  "version": "0.34.0",
  "tipi_version": 6,
  "short_desc": "MCP tools for a Karakeep instance",
  "author": "Karakeep",
  "source": "https://github.com/karakeep-app/karakeep",
  "website": "https://docs.karakeep.app/integrations/mcp/",
  "categories": [
    "ai",
    "utilities"
  ],
  "dynamic_config": true,
  "exposable": false,
  "no_gui": true,
  "supported_architectures": [
    "amd64",
    "arm64"
  ],
  "form_fields": [
    {
      "type": "text",
      "label": "Karakeep API address",
      "env_variable": "KARAKEEP_API_ADDR",
      "hint": "Base URL for the existing Karakeep service.",
      "default": "http://hoarder:3000",
      "required": true
    },
    {
      "type": "password",
      "label": "Karakeep API key",
      "env_variable": "KARAKEEP_API_KEY",
      "required": true
    },
    {
      "type": "random",
      "label": "MCP bearer token",
      "env_variable": "MCP_AUTH_TOKEN",
      "min": 32
    }
  ]
}
