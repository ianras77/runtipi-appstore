{
  "$schema": "../app-info-schema.json",
  "id": "mcp-karakeep",
  "name": "Karakeep MCP",
  "available": true,
  "deprecated": false,
  "port": 3000,
  "description": "Private MCP companion for the Karakeep API. The upstream HTTP transport has no MCP-side auth; keep it on the Runtipi app network.",
  "version": "latest",
  "tipi_version": 1,
  "short_desc": "MCP tools for a Karakeep instance",
  "author": "Karakeep",
  "source": "https://github.com/karakeep-app/karakeep",
  "website": "https://docs.karakeep.app/integrations/mcp/",
  "categories": [
    "ai",
    "utilities"
  ],
  "dynamic_config": true,
  "exposable": false,
  "no_gui": true,
  "supported_architectures": [
    "amd64",
    "arm64"
  ],
  "form_fields": [
    {
      "type": "url",
      "label": "Karakeep API address",
      "env_variable": "KARAKEEP_API_ADDR",
      "hint": "Base URL for the existing Karakeep service.",
      "default": "http://karakeep:3000",
      "required": true
    },
    {
      "type": "password",
      "label": "Karakeep API key",
      "env_variable": "KARAKEEP_API_KEY",
      "required": true
    }
  ]
}
