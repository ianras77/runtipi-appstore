{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "beaverhabits",
      "image": "daya0576/beaverhabits:latest",
      "isMain": true,
      "internalPort": 8080,
      "user": "1000:1000",
      "environment": {
        "HABITS_STORAGE": "USER_DISK",
        "INDEX_HABIT_DATE_COLUMNS": "${INDEX_HABIT_DATE_COLUMNS:-5}",
        "ENABLE_IOS_STANDALONE": "true"
      },
      "volumes": [
        {"hostPath": "${APP_DATA_DIR}/user", "containerPath": "/app/.user"}
      ],
      "healthCheck": {
        "test": "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/', timeout=5)\"",
        "interval": "30s",
        "timeout": "10s",
        "retries": 5,
        "startPeriod": "45s"
      }
    }
  ]
}
