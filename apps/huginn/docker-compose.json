{
  "services": [
    {
      "name": "huginn",
      "image": "huginn/huginn:latest",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "DATABASE_ADAPTER",
          "value": "mysql2"
        },
        {
          "key": "DATABASE_HOST",
          "value": "db"
        },
        {
          "key": "DATABASE_NAME",
          "value": "huginn"
        },
        {
          "key": "DATABASE_USERNAME",
          "value": "huginn"
        },
        {
          "key": "DATABASE_PASSWORD",
          "value": "${HUGINN_DB_PASS:-huginnpass}"
        },
        {
          "key": "REDIS_URL",
          "value": "redis://redis:6379"
        },
        {
          "key": "INVITATION_CODE",
          "value": "${HUGINN_INVITE:-}"
        },
        {
          "key": "FORCE_SSL",
          "value": "false"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/huginn/data",
          "containerPath": "/var/lib/mysql-files"
        }
      ],
      "dependsOn": {
        "db": {
          "condition": "service_started"
        },
        "redis": {
          "condition": "service_started"
        }
      },
      "restart": "unless-stopped"
    },
    {
      "name": "db",
      "image": "mariadb:11",
      "environment": [
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "value": "${HUGINN_DB_ROOT:-rootpass}"
        },
        {
          "key": "MYSQL_DATABASE",
          "value": "huginn"
        },
        {
          "key": "MYSQL_USER",
          "value": "huginn"
        },
        {
          "key": "MYSQL_PASSWORD",
          "value": "${HUGINN_DB_PASS:-huginnpass}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/huginn/db",
          "containerPath": "/var/lib/mysql"
        }
      ],
      "restart": "unless-stopped"
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "restart": "unless-stopped"
    }
  ],
  "schemaVersion": 2
}