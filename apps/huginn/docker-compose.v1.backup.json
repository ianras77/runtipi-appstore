{
  "services": [
    {
      "name": "huginn",
      "image": "huginn/huginn:latest",
      "isMain": true,
      "internalPort": 3000,
      "environment": {
        "DATABASE_ADAPTER": "mysql2",
        "DATABASE_HOST": "db",
        "DATABASE_NAME": "huginn",
        "DATABASE_USERNAME": "huginn",
        "DATABASE_PASSWORD": "${HUGINN_DB_PASS:-huginnpass}",
        "REDIS_URL": "redis://redis:6379",
        "INVITATION_CODE": "${HUGINN_INVITE:-}",
        "FORCE_SSL": "false"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/huginn/data",
          "containerPath": "/var/lib/mysql-files"
        }
      ],
      "dependsOn": {
        "db": {
          "condition": "service_started"
        },
        "redis": {
          "condition": "service_started"
        }
      },
      "restart": "unless-stopped"
    },
    {
      "name": "db",
      "image": "mariadb:11",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${HUGINN_DB_ROOT:-rootpass}",
        "MYSQL_DATABASE": "huginn",
        "MYSQL_USER": "huginn",
        "MYSQL_PASSWORD": "${HUGINN_DB_PASS:-huginnpass}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/huginn/db",
          "containerPath": "/var/lib/mysql"
        }
      ],
      "restart": "unless-stopped"
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "restart": "unless-stopped"
    }
  ]
}