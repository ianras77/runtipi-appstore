{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "rapidforge",
      "image": "celdem/rapidforge:v0.14.0",
      "isMain": true,
      "internalPort": 8080,
      "volumes": [
        {"hostPath": "${APP_DATA_DIR}/data", "containerPath": "/data"}
      ],
      "healthCheck": {
        "test": "curl -fsS http://127.0.0.1:8080/ >/dev/null",
        "interval": "30s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "30s"
      }
    }
  ]
}
