{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "openclaw",
      "image": "ghcr.io/openclaw/openclaw:latest",
      "isMain": true,
      "internalPort": 3130,
      "environment": [
        {
          "key": "OPENCLAW_HOST",
          "value": "0.0.0.0"
        },
        {
          "key": "OPENCLAW_PORT",
          "value": "3130"
        },
        {
          "key": "OPENCLAW_FRONTEND_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "OPENCLAW_TOKEN",
          "value": "${OPENCLAW_TOKEN}"
        },
        {
          "key": "OPENCLAW_CONFIG_DIR",
          "value": "/home/openclaw/.openclaw"
        },
        {
          "key": "OPENCLAW_WORK_DIR",
          "value": "/workspace"
        },
        {
          "key": "OPENCLAW_DEFAULT_PROVIDER",
          "value": "${OPENCLAW_DEFAULT_PROVIDER}"
        },
        {
          "key": "OPENCLAW_DEFAULT_MODEL",
          "value": "${OPENCLAW_DEFAULT_MODEL}"
        },
        {
          "key": "OPENCLAW_OPENAI_API_KEY",
          "value": "${OPENCLAW_OPENAI_API_KEY}"
        },
        {
          "key": "OPENCLAW_ANTHROPIC_API_KEY",
          "value": "${OPENCLAW_ANTHROPIC_API_KEY}"
        },
        {
          "key": "OPENCLAW_OPENROUTER_API_KEY",
          "value": "${OPENCLAW_OPENROUTER_API_KEY}"
        },
        {
          "key": "OPENCLAW_CONTAINERS_DISABLED",
          "value": "${OPENCLAW_CONTAINERS_DISABLED}"
        },
        {
          "key": "OPENCLAW_SANDBOX_IMAGE",
          "value": "${OPENCLAW_SANDBOX_IMAGE}"
        },
        {
          "key": "OPENCLAW_DOCKER_SOCKET",
          "value": "/var/run/docker.sock"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/.openclaw",
          "containerPath": "/home/openclaw/.openclaw"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/workspace",
          "containerPath": "/workspace"
        },
        {
          "hostPath": "/var/run/docker.sock",
          "containerPath": "/var/run/docker.sock"
        }
      ]
    }
  ]
}
