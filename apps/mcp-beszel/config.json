{
  "$schema": "../app-info-schema.json",
  "id": "mcp-beszel",
  "name": "Beszel MCP",
  "available": true,
  "deprecated": false,
  "port": 3000,
  "description": "Read-only MCP companion for Beszel. The MCP endpoint requires a generated bearer token.",
  "version": "1.2.3",
  "tipi_version": 1,
  "short_desc": "Read-only MCP tools for Beszel monitoring",
  "author": "Maxime Bertheau",
  "source": "https://github.com/maxbth/beszel-mcp",
  "website": "https://github.com/maxbth/beszel-mcp",
  "categories": [
    "ai",
    "utilities"
  ],
  "dynamic_config": true,
  "exposable": false,
  "no_gui": true,
  "supported_architectures": [
    "amd64",
    "arm64"
  ],
  "form_fields": [
    {
      "type": "url",
      "label": "Beszel URL",
      "env_variable": "BESZEL_URL",
      "default": "http://beszel:8090",
      "required": true
    },
    {
      "type": "email",
      "label": "Beszel account email",
      "env_variable": "BESZEL_EMAIL",
      "required": true
    },
    {
      "type": "password",
      "label": "Beszel account password",
      "env_variable": "BESZEL_PASSWORD",
      "required": true
    },
    {
      "type": "random",
      "label": "MCP bearer token",
      "env_variable": "MCP_AUTH_TOKEN",
      "min": 32
    }
  ]
}
