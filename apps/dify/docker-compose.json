{
  "services": [
    {
      "name": "console",
      "image": "langgenius/dify-web:latest",
      "isMain": true,
      "internalPort": 3000,
      "restart": "unless-stopped",
      "environment": [
        {
          "key": "CONSOLE_API_BASE_URL",
          "value": "http://api:5001"
        },
        {
          "key": "NEXT_PUBLIC_API_BASE_URL",
          "value": "http://api:5001"
        }
      ],
      "dependsOn": {
        "api": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "api",
      "image": "langgenius/dify-api:latest",
      "restart": "unless-stopped",
      "environment": [
        {
          "key": "DB_URI",
          "value": "postgresql+psycopg2://dify:${POSTGRES_PASSWORD}@postgres:5432/dify"
        },
        {
          "key": "REDIS_URL",
          "value": "redis://redis:6379/0"
        },
        {
          "key": "STORAGE_TYPE",
          "value": "local"
        },
        {
          "key": "STORAGE_LOCAL_PATH",
          "value": "/app/api/storage"
        },
        {
          "key": "VECTOR_STORE",
          "value": "qdrant"
        },
        {
          "key": "QDRANT_URL",
          "value": "http://qdrant:6333"
        },
        {
          "key": "MIGRATION_ENABLED",
          "value": "true"
        },
        {
          "key": "CONSOLE_URL",
          "value": "http://console:3000"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/storage",
          "containerPath": "/app/api/storage"
        }
      ],
      "dependsOn": {
        "postgres": {
          "condition": "service_started"
        },
        "redis": {
          "condition": "service_started"
        },
        "qdrant": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "worker",
      "image": "langgenius/dify-worker:latest",
      "restart": "unless-stopped",
      "environment": [
        {
          "key": "DB_URI",
          "value": "postgresql+psycopg2://dify:${POSTGRES_PASSWORD}@postgres:5432/dify"
        },
        {
          "key": "REDIS_URL",
          "value": "redis://redis:6379/0"
        },
        {
          "key": "VECTOR_STORE",
          "value": "qdrant"
        },
        {
          "key": "QDRANT_URL",
          "value": "http://qdrant:6333"
        }
      ],
      "dependsOn": {
        "postgres": {
          "condition": "service_started"
        },
        "redis": {
          "condition": "service_started"
        },
        "qdrant": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "postgres",
      "image": "postgres:15-alpine",
      "restart": "unless-stopped",
      "environment": [
        {
          "key": "POSTGRES_DB",
          "value": "dify"
        },
        {
          "key": "POSTGRES_USER",
          "value": "dify"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${POSTGRES_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "restart": "unless-stopped"
    },
    {
      "name": "qdrant",
      "image": "qdrant/qdrant:1.12.4",
      "restart": "unless-stopped",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/qdrant",
          "containerPath": "/qdrant/storage"
        }
      ]
    }
  ],
  "schemaVersion": 2
}