{
  "$schema": "../app-info-schema.json",
  "id": "mcp-immich",
  "name": "Immich MCP",
  "available": true,
  "deprecated": false,
  "port": 5000,
  "description": "Bearer-authenticated private MCP gateway to Immich. Use a dedicated least-privilege Immich API key; callers also need the MCP bearer token.",
  "version": "3.3.5",
  "tipi_version": 8,
  "short_desc": "MCP tools for an Immich photo library",
  "author": "barryw",
  "source": "https://github.com/barryw/ImmichMCP",
  "website": "https://github.com/barryw/ImmichMCP",
  "categories": [
    "ai",
    "utilities"
  ],
  "dynamic_config": true,
  "exposable": false,
  "no_gui": true,
  "supported_architectures": [
    "amd64",
    "arm64"
  ],
  "form_fields": [
    {
      "type": "text",
      "label": "Immich base URL",
      "env_variable": "IMMICH_BASE_URL",
      "default": "https://photos.rasies.com",
      "required": true,
      "hint": "Use the HTTPS URL for the existing Immich server."
    },
    {
      "type": "password",
      "label": "Immich API key",
      "env_variable": "IMMICH_API_KEY",
      "required": true
    },
    {
      "type": "password",
      "label": "MCP bearer token",
      "env_variable": "MCP_AUTH_TOKEN",
      "min": 32,
      "max": 256
    }
  ]
}
