{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "immich-mcp",
      "image": "ghcr.io/barryw/immichmcp:v3.3.5",
      "isMain": true,
      "internalPort": 5000,
      "addToMainNetwork": true,
      "environment": {
        "IMMICH_BASE_URL": "${IMMICH_BASE_URL}",
        "IMMICH_API_KEY": "${IMMICH_API_KEY}",
        "IMMICH_TOOL_MODE": "gateway",
        "DOWNLOAD_MODE": "url",
        "MCP_PORT": "5000"
      }
    }
  ]
}
