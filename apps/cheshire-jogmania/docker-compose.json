{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "cheshire-jogmania",
      "image": "ghcr.io/cheshire-cat-ai/core:1.9.2",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        { "key": "CCAT_QDRANT_HOST", "value": "qdrant" },
        { "key": "CCAT_QDRANT_PORT", "value": 6333 }
      ],
      "dependsOn": {
        "qdrant": { "condition": "service_started" },
        "redis": { "condition": "service_started" }
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/static",  "containerPath": "/app/cat/static" },
        { "hostPath": "${APP_DATA_DIR}/data/plugins", "containerPath": "/app/cat/plugins" },
        { "hostPath": "${APP_DATA_DIR}/data/data",    "containerPath": "/app/cat/data" }
      ],
      "healthCheck": {
        "test": "wget -qO- http://localhost/healthz || exit 1",
        "interval": "30s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "30s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "5"
        }
      }
    },
    {
      "name": "qdrant",
      "image": "qdrant/qdrant:v1.12.0",
      "internalPort": 6333,
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/qdrant", "containerPath": "/qdrant/storage" }
      ],
      "ulimits": {
        "nofile": { "soft": 1048576, "hard": 1048576 }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "5"
        }
      }
    },
    {
      "name": "redis",
      "image": "redis:7.2-alpine",
      "internalPort": 6379,
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/redis", "containerPath": "/data" }
      ],
      "healthCheck": {
        "test": "redis-cli ping | grep -q PONG",
        "interval": "10s",
        "timeout": "3s",
        "retries": 30,
        "startPeriod": "10s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "5"
        }
      }
    }
  ]
}

