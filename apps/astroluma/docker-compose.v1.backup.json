{
  "services": [
    {
      "name": "astroluma",
      "image": "sanjeet990/astroluma:latest",
      "isMain": true,
      "internalPort": 8000,
      "restart": "unless-stopped",
      "environment": {
        "PORT": "8000",
        "NODE_ENV": "production",
        "SECRET_KEY": "${SECRET_KEY}",
        "MONGODB_URI": "mongodb://mongo:27017/astroluma"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/uploads",
          "containerPath": "/app/storage/uploads"
        }
      ],
      "dependsOn": {
        "mongo": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "mongo",
      "image": "mongo:6.0",
      "restart": "unless-stopped",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/mongo",
          "containerPath": "/data/db"
        }
      ]
    }
  ]
}