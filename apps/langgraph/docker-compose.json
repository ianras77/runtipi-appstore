{
  "services": [
    {
      "name": "langgraph-api",
      "image": "langchain/langgraph-api:3.12",
      "isMain": true,
      "internalPort": 8123,
      "environment": [
        {
          "key": "PORT",
          "value": "8123"
        },
        {
          "key": "REDIS_URI",
          "value": "redis://redis:6379/0"
        },
        {
          "key": "DATABASE_URL",
          "value": "postgresql://langgraph:${LANGGRAPH_DB_PASSWORD}@postgres:5432/langgraph"
        }
      ],
      "dependsOn": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_started"
        }
      },
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost:8123/ || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "40s"
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16",
      "environment": [
        {
          "key": "POSTGRES_DB",
          "value": "langgraph"
        },
        {
          "key": "POSTGRES_USER",
          "value": "langgraph"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${LANGGRAPH_DB_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "pg_isready -U langgraph -d langgraph",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "redis",
      "image": "redis:7.2",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/redis",
          "containerPath": "/data"
        }
      ],
      "restart": "always"
    }
  ],
  "schemaVersion": 2
}