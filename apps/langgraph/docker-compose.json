{
  "services": [
    {
      "name": "langgraph-api",
      "image": "langchain/langgraph-api:3.12",
      "isMain": true,
      "internalPort": 8123,
      "environment": {
        "PORT": "8123",
        "REDIS_URI": "redis://redis:6379/0",
        "DATABASE_URL": "postgresql://langgraph:${LANGGRAPH_DB_PASSWORD}@postgres:5432/langgraph"
      },
      "dependsOn": {
        "postgres": { "condition": "service_healthy" },
        "redis": { "condition": "service_started" }
      },
      "restart": "always",
      "healthCheck": {
        "test": "curl -fsS http://localhost:8123/ || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "40s"
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16",
      "environment": {
        "POSTGRES_DB": "langgraph",
        "POSTGRES_USER": "langgraph",
        "POSTGRES_PASSWORD": "${LANGGRAPH_DB_PASSWORD}"
      },
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/postgres", "containerPath": "/var/lib/postgresql/data" }
      ],
      "restart": "always",
      "healthCheck": {
        "test": "pg_isready -U langgraph -d langgraph",
        "interval": "30s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    {
      "name": "redis",
      "image": "redis:7.2",
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/redis", "containerPath": "/data" }
      ],
      "restart": "always"
    }
  ]
}

