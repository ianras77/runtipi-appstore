{
  "name": "runtipi-release-review",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-official.mjs",
    "compile:schemas": "tsc schemas/upstream/packages/common/src/schemas/app-info.ts schemas/upstream/packages/common/src/schemas/compose-yaml.ts schemas/upstream/packages/common/src/types/app-urn.ts schemas/upstream/packages/common/src/schemas/dynamic-compose.ts --outDir schemas/compiled --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck --strict",
    "test:inventory": "node scripts/check-provenance.mjs && npm run compile:schemas && node --test tests/*.test.mjs && node scripts/validate-inventory.mjs --baseline baseline-inventory.json --output inventory-report.json"
  },
  "dependencies": {
    "@runtipi/common": "1.1.3",
    "arktype": "2.1.29",
    "typescript": "5.9.3",
    "yaml": "2.8.2"
  }
}
